# Local development only. Set these in the PaaS dashboard for production.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-local-development-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Leaving DATABASE_URL unset uses SQLite only in development and tests.
# Production requires a managed PostgreSQL URL, for example:
# DATABASE_URL=postgresql://user:password@host:5432/polls?sslmode=require
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=polls.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://polls.example.com
